{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Inimark",
  "version": "0.1.5",
  "identifier": "com.inimark.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Inimark",
        "width": 1100,
        "height": 760,
        "minWidth": 720,
        "minHeight": 480,
        "resizable": true,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 14,
          "y": 11
        },
        "transparent": true,
        "shadow": true,
        "backgroundColor": "#00000000"
      },
      {
        "label": "settings",
        "title": "Inimark Settings",
        "url": "settings.html",
        "width": 920,
        "height": 640,
        "minWidth": 640,
        "minHeight": 420,
        "resizable": true,
        "center": true,
        "visible": false,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 14,
          "y": 11
        },
        "transparent": true,
        "shadow": true,
        "backgroundColor": "#00000000"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk1NzBCQ0VCMUM4QTYwODkKUldTSllJb2M2N3h3bFVPY1h3bjFYY2FPQWljSnJ0T2ZiZnQ2N0d3S0ovcm5zZVh0TWFnaGRpbEoK",
      "endpoints": [
        "https://github.com/Dionysen/Inimark2/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
