{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vellum",
  "version": "0.1.1",
  "identifier": "com.dionysen.vellum",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Vellum",
        "width": 960,
        "height": 680,
        "minWidth": 640,
        "minHeight": 420,
        "resizable": true,
        "visible": false,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 14,
          "y": 11
        },
        "transparent": true,
        "shadow": true,
        "backgroundColor": "#00000000",
        "zoomHotkeysEnabled": false
      },
      {
        "label": "settings",
        "title": "Vellum Settings",
        "url": "settings.html",
        "width": 860,
        "height": 600,
        "minWidth": 640,
        "minHeight": 420,
        "resizable": true,
        "center": true,
        "visible": false,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 14,
          "y": 11
        },
        "transparent": true,
        "shadow": true,
        "backgroundColor": "#00000000",
        "zoomHotkeysEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["vellum"]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk1NzBCQ0VCMUM4QTYwODkKUldTSllJb2M2N3h3bFVPY1h3bjFYY2FPQWljSnJ0T2ZiZnQ2N0d3S0ovcm5zZVh0TWFnaGRpbEoK",
      "endpoints": [
        "https://github.com/Dionysen/Inimark/releases/download/vellum-latest/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
