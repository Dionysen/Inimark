{
  "name": "inimark",
  "private": true,
  "version": "1.0.4",
  "packageManager": "pnpm@10.15.1",
  "scripts": {
    "dev": "pnpm --filter @inimark/desktop dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "test:editor": "pnpm --filter @inimark/editor test",
    "test:desktop": "pnpm --filter @inimark/desktop test",
    "typecheck": "pnpm -r typecheck",
    "tauri": "pnpm --filter @inimark/desktop tauri",
    "bump-version": "node scripts/bump-version.mjs",
    "replace-icon": "node scripts/replace-icon.mjs",
    "docs:build": "tsx scripts/publish-docs.ts",
    "docs:deploy": "tsx scripts/publish-docs.ts --deploy --skip-build"
  },
  "devDependencies": {
    "happy-dom": "^20.9.0",
    "sharp": "^0.34.4",
    "tsx": "^4.20.5"
  }
}
